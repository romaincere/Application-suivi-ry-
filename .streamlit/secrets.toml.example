# Copie ce fichier en `.streamlit/secrets.toml` pour le dev local,
# ou colle son contenu dans Streamlit Cloud → Settings → Secrets.

# Mot de passe d'accès à l'app
app_password = "change-moi"

# Clé Fernet pour chiffrer/déchiffrer le portefeuille.
# Générer avec :
#   python -m src.storage.portfolio_store
fernet_key = "REMPLACE_PAR_UNE_CLE_FERNET_VALIDE"

# (Optionnel) Clé API Finnhub pour l'indicateur "Insider Buying".
# Créer un compte gratuit sur https://finnhub.io → Dashboard → API Key.
# finnhub_api_key = "ton-token-finnhub"

# (Optionnel) Clé API Anthropic Claude pour l'estimation IA des critères
# qualitatifs (Moat, Qualité management, Parts de marché).
# Créer un compte sur https://console.anthropic.com → Settings → API Keys.
# anthropic_api_key = "sk-ant-api03-..."
