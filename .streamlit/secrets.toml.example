# Copie ce fichier en `.streamlit/secrets.toml` pour le dev local,
# ou colle son contenu dans Streamlit Cloud → Settings → Secrets.

# Mot de passe d'accès à l'app
app_password = "change-moi"

# Clé Fernet pour chiffrer/déchiffrer le portefeuille.
# Générer avec :
#   python -m src.storage.portfolio_store
fernet_key = "REMPLACE_PAR_UNE_CLE_FERNET_VALIDE"
